{
  "pluginAlias": "iAquaLink",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "<p align=\"center\"><img src=\"https://raw.githubusercontent.com/dean1d/homebridge-iAqualink-Matter/main/assets/Jandy.png\" alt=\"Jandy iAquaLink logo\" width=\"180\"></p>\n\nControl supported Jandy iAquaLink pool equipment through HomeKit and Matter.\n\n> This independent community plugin is not affiliated with or endorsed by Jandy or Fluidra.",
  "schema": {
    "type": "object",
    "required": ["name", "username", "password"],
    "properties": {
      "name": {"title": "Name", "type": "string", "default": "iAquaLink"},
      "username": {"title": "iAquaLink Email", "type": "string"},
      "password": {"title": "iAquaLink Password", "type": "string"},
      "enableCloudControl": {
        "title": "Enable Cloud Control",
        "description": "Allow HomeKit and Matter to send commands to real pool equipment.",
        "type": "boolean",
        "default": true
      },
      "pollIntervalSeconds": {"title": "Polling Interval", "type": "integer", "minimum": 15, "maximum": 300, "default": 30},
      "diagnosticMode": {"title": "Diagnostic Logging", "type": "boolean", "default": false},
      "exposeLightShows": {
        "title": "Expose Light Colors and Shows as Switches",
        "description": "Add a momentary HomeKit switch for each discovered Jandy light color and show.",
        "type": "boolean",
        "default": true
      },
      "poolLightProgram": {
        "title": "Pool Light Program",
        "type": "string",
        "default": "Caribbean Blue",
        "enum": ["Alpine White", "Sky Blue", "Cobalt Blue", "Caribbean Blue", "Spring Green", "Emerald Green", "Emerald Rose", "Magenta", "Violet", "Slow Color Splash", "Fast Color Splash", "America The Beautiful", "Fat Tuesday", "Disco Tech"]
      },
      "spaLightProgram": {
        "title": "Spa Light Program",
        "type": "string",
        "default": "Caribbean Blue",
        "enum": ["Alpine White", "Sky Blue", "Cobalt Blue", "Caribbean Blue", "Spring Green", "Emerald Green", "Emerald Rose", "Magenta", "Violet", "Slow Color Splash", "Fast Color Splash", "America The Beautiful", "Fat Tuesday", "Disco Tech"]
      },
      "useMockApi": {"title": "Use Mock API (Development Only)", "type": "boolean", "default": false}
    }
  },
  "layout": [
    "name", "username", "password", "enableCloudControl", "pollIntervalSeconds",
    "exposeLightShows",
    "poolLightProgram", "spaLightProgram", "diagnosticMode", "useMockApi"
  ]
}
