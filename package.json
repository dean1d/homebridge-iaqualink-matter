{
  "name": "homebridge-iaqualink-matter",
  "version": "0.1.1",
  "description": "Homebridge 2 dynamic platform plugin for Jandy iAquaLink with HAP and Matter support.",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "type": "module",
  "publishConfig": {"access": "public"},
  "displayName": "homebridge-iAqualink-Matter",
  "keywords": ["homebridge-plugin", "supports-hap", "supports-matter", "iaqualink", "jandy", "pool", "spa", "matter"],
  "engines": {
    "homebridge": "^2.0.0",
    "node": "^22.12.0 || ^24.0.0"
  },
  "repository": {"type": "git", "url": "git+https://github.com/dean1d/homebridge-iAqualink-Matter.git"},
  "bugs": {"url": "https://github.com/dean1d/homebridge-iAqualink-Matter/issues"},
  "homepage": "https://github.com/dean1d/homebridge-iAqualink-Matter#readme",
  "files": ["dist", "config.schema.json", "README.md", "LICENSE", "CHANGELOG.md"],
  "scripts": {
    "clean": "rimraf dist coverage",
    "build": "rimraf dist && tsc",
