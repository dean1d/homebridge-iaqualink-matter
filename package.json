    "watch": "nodemon",
    "lint": "eslint src test --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run build && npm test",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "homebridge": "^2.0.0",
    "nodemon": "^3.1.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
